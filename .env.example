# Create this in KeeperHub: Settings > API Keys > Organisation.
# It must start with kh_. Never expose it to browser-side code.
KEEPERHUB_API_KEY=kh_replace_me
KEEPERHUB_BASE_URL=https://app.keeperhub.com/api

# Ethereum Sepolia. KeeperHub must report this chain as enabled + testnet.
KEEPERHUB_CHAIN_ID=11155111

# Allowlisted destination for the small testnet safety transfer.
KEEPERHUB_RECIPIENT_ADDRESS=0xReplaceWithYourSepoliaAddress

# Native-token amounts, expressed in ETH on Sepolia.
KEEPERHUB_TRANSFER_AMOUNT=0.00001
KEEPERHUB_DAILY_CAP=0.00005

# Live broadcast remains disabled until this is explicitly true.
LIVE_EXECUTION_ENABLED=false

# Market-risk policy.
MIN_DROP_BPS=150
MIN_CONFIDENCE=0.90
